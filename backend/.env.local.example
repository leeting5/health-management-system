# 本地开发环境变量示例。
# 复制本文件为 backend/.env.local，并按本机环境填写。
# .env.local 已被 .gitignore 忽略，不会被提交到 Git 仓库。

DB_USERNAME=root
DB_PASSWORD=replace_with_your_local_mysql_password
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
DEEPSEEK_API_KEY=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
AI_REDIS_ENABLED=false
